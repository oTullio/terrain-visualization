{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../..",
    "composite": true,
    "moduleResolution": "node16",
    "module": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@terrain/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": [
    "api/**/*.ts",
    "lib/**/*.ts",
    "vitest.config.ts",
    "../../packages/shared/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../../packages/shared/src/**/*.test.ts",
    "../../packages/shared/src/**/*.spec.ts"
  ]
}
